{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__strava-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/capture-strava.js"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__strava-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/capture-strava.js"
          }
        ]
      }
    ]
  }
}
